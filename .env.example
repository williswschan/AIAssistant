AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2.1
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.5
AZURE_OPENAI_VOICE=marin
AZURE_REASONING_EFFORT=high
AZURE_INTERRUPT_RESPONSE=true
AZURE_VAD_THRESHOLD=0.8
AZURE_VAD_PREFIX_MS=300
AZURE_VAD_SILENCE_MS=900
# true = write call transcripts under logs/transcripts/ (disable for production)
TRANSCRIPT_LOGGING=true
# Optional Azure deployment name for user-speech ASR (whisper / gpt-4o-transcribe, etc.)
# Leave empty to log assistant speech + tools only (user turns show as speech markers)
AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=
PROMPT_CACHE_RETENTION=24h
PROMPT_CACHE_WARMUP=true
# Realtime (voice): automatic in-memory prompt cache when Azure supports it.
# retention_ratio 0.8 = cache-friendlier truncation on long calls (OpenAI/Azure guidance).
REALTIME_TRUNCATION_RETENTION_RATIO=0.8
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_SSL=true
